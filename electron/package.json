{
  "name": "herbairium",
  "version": "0.1.0",
  "description": "Herbarium specimen image processor",
  "main": "main/dist/index.js",
  "scripts": {
    "dev:renderer": "cd renderer && npm run dev",
    "dev:main": "tsc -p main/tsconfig.json --watch",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on http://localhost:5173 && electron .\"",
    "build:main": "tsc -p main/tsconfig.json",
    "build:renderer": "cd renderer && npm run build",
    "build": "npm run build:main && npm run build:renderer",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "extends": "./build/electron-builder.yml"
  }
}
